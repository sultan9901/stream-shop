# ==========================================================================
# Keep the build context small and — more importantly — keep secrets and local
# state out of the image. Everything the app needs at runtime is copied
# explicitly by the Dockerfile.
# ==========================================================================

# --- secrets: never bake credentials into a layer -------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- local virtualenvs / interpreter state --------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyd
*.so
.Python

# --- local databases and user-uploaded files (bind-mounted volumes) -------
*.db
*.db-journal
*.sqlite
*.sqlite3
uploads/
stream_corporation.db

# --- test / tooling caches -------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
tests/.tmp/

# --- vcs / editors / OS ---------------------------------------------------
.git/
.gitignore
.github/
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- agent / session state ------------------------------------------------
.claude/

# --- docs and compose files (not needed inside the image) ------------------
README.md
docker-compose.yml
docker-compose.*.yml
